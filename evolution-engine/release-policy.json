{
  "schemaVersion": 1,
  "mode": "review-gated-autonomous-development",
  "automaticRepositoryWrites": false,
  "automaticMerge": false,
  "automaticProductionDeployment": false,
  "allowedAutonomousStages": [
    "inspect-version-controlled-capability-registry",
    "run-deterministic-gap-audit",
    "rank-findings",
    "prepare-improvement-work-items",
    "run-existing-tests",
    "execute-reviewed-exact-match-remediation-recipes",
    "run-full-tests-and-production-build",
    "open-review-only-pull-request-for-validated-repairs",
    "compile-approved-declarative-model-specifications",
    "run-generated-model-verification-tests"
  ],
  "approvalRequiredStages": [
    "install-or-update-dependencies",
    "change-engineering-models-or-safety-rules",
    "modify-workflows-or-permissions",
    "merge-pull-request",
    "publish-production-release",
    "author-or-enable-remediation-recipes",
    "author-or-enable-model-generation-specifications"
  ],
  "requiredGates": [
    "unit-and-integration-tests",
    "production-build",
    "browser-end-to-end-audit",
    "dependency-and-secret-audit",
    "license-and-provenance-review",
    "rollback-reference"
  ],
  "remediationConstraints": {
    "exactMatchPrecondition": true,
    "maxRecipesPerRun": 1,
    "permittedPathPrefixes": [
      "scripts/",
      "evolution-engine/",
      "research-engine/",
      "approved-root-engineering-modules"
    ],
    "protectedPaths": [
      ".github/",
      "package.json",
      "package-lock.json",
      "capabilities.json",
      "evolution-engine/release-policy.json"
    ],
    "rollbackOnAnyValidationFailure": true,
    "automaticPullRequest": true,
    "automaticMerge": false,
    "productionDeployment": false,
    "permittedRootFiles": [
      "app.js",
      "advanced-labs.js",
      "robotics-core.js",
      "nano-core.mjs",
      "printing-core.mjs",
      "printing-lab.js",
      "research-labs.js",
      "research-next.js",
      "visual-circuit.js",
      "navigation.js"
    ]
  },
  "automaticPullRequestBranchWrites": true,
  "modelGenerationConstraints": {
    "sourceFormat": "JSON declarative expression AST; no eval, Function constructor, shell snippets or arbitrary source strings",
    "allowedOperations": [
      "add",
      "sub",
      "mul",
      "div",
      "sqrt",
      "pow",
      "abs",
      "min",
      "max"
    ],
    "maxExpressionDepth": 32,
    "maxParameters": 32,
    "maxOutputs": 32,
    "maxVerificationVectors": 100,
    "requiresNumericalVerificationVectors": true,
    "requiresEducationalOnly": true,
    "hardwareControl": false,
    "requiresLimitations": true,
    "automaticExecutionOnlyForEnabledSpecifications": true
  }
}
